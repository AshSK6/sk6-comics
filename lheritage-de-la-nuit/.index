<!DOCTYPE html>
<html lang="en">

<head>

<meta charset="UTF-8">

<meta
  name="viewport"
  content="width=device-width, initial-scale=1.0"
>

<title>L’Héritage de la Nuit — SK6</title>

<style>

* {
  box-sizing: border-box;
}

:root {
  --black: #080808;
  --white: #f2f2ee;
  --gold: #c9a45c;
}

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;
  background: var(--black);
  color: var(--white);
  font-family: Arial, Helvetica, sans-serif;
  overflow-x: hidden;
}


/* PAGE */

.page {

  max-width: 1100px;

  margin: auto;

  padding:
    20px
    25px
    80px;
}


/* TOP BAR */

.topbar {

  display: flex;

  justify-content: space-between;

  align-items: center;

  padding:
    12px
    0
    18px;

  border-bottom:
    2px solid
    var(--white);
}


/* SK6 */

.logo {

  color: var(--gold);

  text-decoration: none;

  font-size: 18px;

  font-weight: 900;

  letter-spacing: 4px;

  transition:
    color .15s ease,
    transform .15s ease;
}

.logo:hover {

  color: var(--white);

  transform:
    translateY(-2px);
}


/* BACK */

.back {

  color: var(--white);

  text-decoration: none;

  font-size: 10px;

  font-weight: 900;

  letter-spacing: 2px;

  text-transform: uppercase;

  transition:
    color .15s ease;
}

.back:hover {

  color: var(--gold);
}


/* HERO */

.hero {

  padding:
    70px
    0
    60px;

  text-align: center;

  border-bottom:
    10px solid
    var(--white);
}


/* LABEL */

.label {

  color: var(--gold);

  font-size: 10px;

  font-weight: 900;

  letter-spacing: 4px;

  text-transform: uppercase;

  margin-bottom: 25px;
}


/* TITLE */

h1 {

  margin: 0;

  font-size:
    clamp(
      55px,
      10vw,
      110px
    );

  line-height: .8;

  letter-spacing: -6px;

  text-transform: uppercase;

  font-weight: 900;
}


/* SUBTITLE */

.subtitle {

  margin-top: 25px;

  font-size: 12px;

  font-weight: 900;

  letter-spacing: 4px;

  text-transform: uppercase;

  color: var(--gold);
}


/* PREVIEW */

.preview {

  width: 100%;

  max-width: 650px;

  margin:
    60px
    auto
    40px;

  background: var(--black);

  border:
    4px solid
    var(--white);

  box-shadow:
    12px 12px 0
    var(--gold);

  overflow: hidden;

  position: relative;
}


.preview img {

  display: block;

  width: 100%;

  height: 520px;

  object-fit: cover;

  object-position: top center;

  transition:
    transform .4s ease;
}


.preview:hover img {

  transform:
    scale(1.03);
}


/* CHAPTER LABEL */

.chapter-label {

  position: absolute;

  top: 15px;

  left: 15px;

  z-index: 5;

  background: var(--gold);

  color: var(--black);

  padding:
    7px
    10px;

  font-size: 9px;

  font-weight: 900;

  letter-spacing: 2px;

  text-transform: uppercase;
}


/* INFO */

.info {

  max-width: 700px;

  margin:
    50px
    auto
    0;

  text-align: center;
}


.info p {

  margin: 0;

  font-size: 13px;

  font-weight: 900;

  line-height: 1.6;

  text-transform: uppercase;
}


/* READ BUTTON */

.read-button {

  display: inline-block;

  margin-top: 30px;

  padding:
    15px
    24px;

  background: var(--gold);

  color: var(--black);

  text-decoration: none;

  font-size: 11px;

  font-weight: 900;

  letter-spacing: 3px;

  text-transform: uppercase;

  transition:
    transform .15s ease,
    background .15s ease,
    color .15s ease;
}


.read-button:hover {

  transform:
    translateY(-4px);

  background: var(--white);

  color: var(--black);
}


/* FOOTER */

.footer {

  margin-top: 100px;

  padding-top: 20px;

  border-top:
    2px solid
    rgba(242,242,238,.25);

  display: flex;

  justify-content: space-between;

  font-size: 9px;

  font-weight: 900;

  letter-spacing: 3px;

  text-transform: uppercase;

  opacity: .5;
}


.footer span:last-child {

  color: var(--gold);
}


/* MOBILE */

@media (max-width: 700px) {

  .page {

    padding:
      15px
      15px
      60px;
  }


  .hero {

    padding:
      55px
      0
      45px;
  }


  h1 {

    font-size:
      clamp(
        48px,
        14vw,
        75px
      );

    letter-spacing: -4px;
  }


  .preview {

    margin-top: 45px;

    box-shadow:
      8px 8px 0
      var(--gold);
  }


  .preview img {

    height: 400px;
  }


  .footer {

    font-size: 8px;
  }

}

</style>

</head>


<body>


<div class="page">


  <!-- TOP BAR -->

  <div class="topbar">


    <a
      class="logo"
      href="../"
    >
      SK6
    </a>


    <a
      class="back"
      href="../"
    >
      Back to SK6
    </a>


  </div>



  <!-- HERO -->

  <main class="hero">


    <div class="label">

      SK6 // SERIES // 004

    </div>


    <h1>

      L’Héritage<br>
      de la Nuit

    </h1>


    <div class="subtitle">

      Chapter 01 // Now Available

    </div>



    <!-- PREVIEW -->

    <a
      href="CHAPTER1/"
      class="preview"
    >


      <div class="chapter-label">

        CHAPTER 01

      </div>


      <img
        src="CHAPTER1/H_c1_01%20Large.jpeg"
        alt="L’Héritage de la Nuit — Chapter 01"
      >


    </a>



    <!-- INFO -->

    <div class="info">


      <p>

        Beyond the walls, monsters rule
        the wild lands. The Church of Light
        trains hunters to protect humanity
        from the creatures that haunt the roads,
        forests and villages.

      </p>


      <a
        class="read-button"
        href="CHAPTER1/"
      >

        Read Chapter 01 →

      </a>


    </div>


  </main>



  <!-- FOOTER -->

  <div class="footer">


    <span>

      SK6 // L’HÉRITAGE DE LA NUIT

    </span>


    <span>

      001 / 019

    </span>


  </div>


</div>


</body>

</html>
