<!DOCTYPE html>
<html lang="en">

<head>

<meta charset="UTF-8">

<meta
  name="viewport"
  content="width=device-width, initial-scale=1.0"
>

<title>L’Héritage de la Nuit — SK6</title>


<style>

* {
  box-sizing: border-box;
}


:root {

  --black: #080808;
  --white: #f2f2ee;
  --gold: #c9a45c;

}


html {

  scroll-behavior:
    smooth;

}


body {

  margin: 0;

  background:
    var(--black);

  color:
    var(--white);

  font-family:
    Arial,
    Helvetica,
    sans-serif;

  overflow-x:
    hidden;

}


/* PAGE */

.page {

  width:
    100%;

  max-width:
    1100px;

  margin:
    0 auto;

  padding:
    20px
    25px
    80px;

}


/* TOP BAR */

.topbar {

  display:
    flex;

  justify-content:
    space-between;

  align-items:
    center;

  padding:
    15px
    0
    20px;

  border-bottom:
    2px solid
    var(--white);

}


.logo {

  color:
    var(--gold);

  text-decoration:
    none;

  font-size:
    18px;

  font-weight:
    900;

  letter-spacing:
    4px;

}


.back {

  color:
    var(--white);

  text-decoration:
    none;

  font-size:
    10px;

  font-weight:
    900;

  letter-spacing:
    2px;

  text-transform:
    uppercase;

}


.back:hover {

  color:
    var(--gold);

}


/* HERO */

.hero {

  text-align:
    center;

  padding:
    80px
    20px
    60px;

  border-bottom:
    10px solid
    var(--white);

}


.label {

  color:
    var(--gold);

  font-size:
    11px;

  font-weight:
    900;

  letter-spacing:
    5px;

  text-transform:
    uppercase;

  margin-bottom:
    25px;

}


h1 {

  margin:
    0;

  font-size:
    clamp(
      55px,
      11vw,
      120px
    );

  line-height:
    .8;

  letter-spacing:
    -6px;

  text-transform:
    uppercase;

}


.subtitle {

  margin:
    30px auto 0;

  max-width:
    650px;

  font-size:
    13px;

  font-weight:
    900;

  line-height:
    1.5;

  text-transform:
    uppercase;

  opacity:
    .75;

}


/* CHAPTER */

.chapter-section {

  margin-top:
    70px;

}


.section-title {

  display:
    flex;

  justify-content:
    space-between;

  align-items:
    flex-end;

  border-bottom:
    3px solid
    var(--white);

  padding-bottom:
    15px;

  margin-bottom:
    40px;

}


.section-title h2 {

  margin:
    0;

  font-size:
    clamp(
      40px,
      8vw,
      80px
    );

  line-height:
    .8;

  letter-spacing:
    -5px;

  text-transform:
    uppercase;

}


.section-label {

  color:
    var(--gold);

  font-size:
    10px;

  font-weight:
    900;

  letter-spacing:
    3px;

  text-transform:
    uppercase;

}


/* CHAPTER CARD */

.chapter-card {

  display:
    grid;

  grid-template-columns:
    1fr
    1fr;

  gap:
    30px;

  padding:
    15px;

  background:
    var(--white);

  color:
    var(--black);

  text-decoration:
    none;

  border:
    5px solid
    var(--white);

  box-shadow:
    12px 12px 0
    var(--gold);

  transition:
    transform .2s ease,
    box-shadow .2s ease;

}


.chapter-card:hover {

  transform:
    translateY(-8px);

  box-shadow:
    18px 18px 0
    var(--gold);

}


/* PREVIEW */

.preview {

  aspect-ratio:
    3 / 4;

  background:
    var(--black);

  overflow:
    hidden;

  position:
    relative;

}


.preview img {

  width:
    100%;

  height:
    100%;

  object-fit:
    cover;

  object-position:
    center top;

  display:
    block;

  transition:
    transform .4s ease;

}


.chapter-card:hover .preview img {

  transform:
    scale(1.04);

}


.preview::after {

  content:
    "";

  position:
    absolute;

  inset:
    0;

  border:
    4px solid
    var(--gold);

  pointer-events:
    none;

}


/* INFO */

.chapter-info {

  display:
    flex;

  flex-direction:
    column;

  justify-content:
    center;

  padding:
    20px;

}


.chapter-number {

  color:
    var(--gold);

  font-size:
    11px;

  font-weight:
    900;

  letter-spacing:
    4px;

  text-transform:
    uppercase;

  margin-bottom:
    20px;

}


.chapter-info h3 {

  margin:
    0;

  font-size:
    clamp(
      35px,
      6vw,
      70px
    );

  line-height:
    .8;

  letter-spacing:
    -4px;

  text-transform:
    uppercase;

}


.chapter-info p {

  margin:
    25px 0;

  font-size:
    11px;

  font-weight:
    900;

  line-height:
    1.5;

  text-transform:
    uppercase;

}


.read {

  display:
    inline-block;

  width:
    fit-content;

  padding:
    12px
    18px;

  background:
    var(--gold);

  color:
    var(--black);

  font-size:
    11px;

  font-weight:
    900;

  letter-spacing:
    2px;

  text-transform:
    uppercase;

}


/* FOOTER */

footer {

  margin-top:
    90px;

  padding-top:
    20px;

  border-top:
    2px solid
    rgba(242,242,238,.25);

  text-align:
    center;

  font-size:
    9px;

  font-weight:
    900;

  letter-spacing:
    3px;

  text-transform:
    uppercase;

  opacity:
    .5;

}


footer span {

  color:
    var(--gold);

}


/* MOBILE */

@media (max-width: 750px) {

  .page {

    padding:
      15px
      15px
      60px;

  }


  .hero {

    padding:
      60px
      10px
      45px;

  }


  .chapter-card {

    grid-template-columns:
      1fr;

    gap:
      10px;

  }


  .chapter-info {

    padding:
      20px
      10px
      15px;

  }


  .section-title {

    display:
      block;

  }


  .section-label {

    display:
      block;

    margin-top:
      15px;

  }

}

</style>

</head>


<body>


<div class="page">


<!-- TOP BAR -->

<div class="topbar">


  <a
    class="logo"
    href="../"
  >

    SK6

  </a>


  <a
    class="back"
    href="../"
  >

    ← Back to SK6

  </a>


</div>


<!-- HERO -->

<header class="hero">


  <div class="label">

    SK6 // SERIES // 004

  </div>


  <h1>

    L’Héritage<br>
    de la Nuit

  </h1>


  <p class="subtitle">

    Beyond the walls, monsters rule the wild.
    Hunters stand between humanity and the
    creatures waiting in the darkness.

  </p>


</header>


<!-- CHAPTER -->

<main class="chapter-section">


  <div class="section-title">


    <h2>

      Chapters

    </h2>


    <div class="section-label">

      L’HÉRITAGE DE LA NUIT

    </div>


  </div>


  <!-- CHAPTER 01 -->

  <a
    class="chapter-card"
    href="CHAPTER1/"
  >


    <div class="preview">


      <img
        src="CHAPTER1/H_c1_01%20Large.jpeg"
        alt="L’Héritage de la Nuit — Chapter 01"
      >


    </div>


    <div class="chapter-info">


      <div class="chapter-number">

        CHAPTER 01

      </div>


      <h3>

        The Shadow<br>
        Crowned

      </h3>


      <p>

        The first chapter of
        L’Héritage de la Nuit.

        Enter the world.
        Face the monsters.

      </p>


      <div class="read">

        READ CHAPTER →

      </div>


    </div>


  </a>


</main>


<!-- FOOTER -->

<footer>

  <span>
    SK6
  </span>

  // L’HÉRITAGE DE LA NUIT

  <br><br>

  COMICS / ART / CHAOS

</footer>


</div>


</body>

</html>
