<!DOCTYPE html>
<html lang="en">

<head>

<meta charset="UTF-8">

<meta
  name="viewport"
  content="width=device-width, initial-scale=1.0"
>

<title>L’Héritage de la Nuit — SK6</title>


<style>

* {
  box-sizing: border-box;
}


:root {
  --black: #080808;
  --white: #f2f2ee;
  --gold: #c9a45c;
}


html {
  scroll-behavior: smooth;
}


body {

  margin: 0;

  background: var(--black);

  color: var(--white);

  font-family:
    Arial,
    Helvetica,
    sans-serif;

  overflow-x: hidden;
}


/* BACKGROUND */

body::before {

  content:
    "L'HÉRITAGE  L'HÉRITAGE  L'HÉRITAGE";

  position: fixed;

  top: 40%;

  left: -20%;

  width: 140%;

  font-size: 10vw;

  font-weight: 900;

  letter-spacing: -5px;

  white-space: nowrap;

  color:
    rgba(255,255,255,.025);

  transform:
    rotate(-6deg);

  pointer-events: none;

  z-index: 0;
}


/* PAGE */

.page {

  max-width: 1100px;

  margin: 0 auto;

  padding:
    20px
    25px
    100px;

  position: relative;

  z-index: 1;
}


/* TOP BAR */

nav {

  display: flex;

  justify-content:
    space-between;

  align-items: center;

  padding:
    12px
    0
    18px;

  border-bottom:
    2px solid
    var(--white);
}


/* SK6 */

.nav-logo {

  color:
    var(--gold);

  text-decoration: none;

  font-size: 18px;

  font-weight: 900;

  letter-spacing: 4px;

  transition:
    color .15s ease,
    transform .15s ease;
}


.nav-logo:hover {

  color:
    var(--white);

  transform:
    translateY(-2px);
}


/* NAV LINKS */

.nav-links {

  display: flex;

  gap: 25px;
}


.nav-links a {

  color:
    var(--white);

  text-decoration: none;

  font-size: 10px;

  font-weight: 900;

  letter-spacing: 2px;

  text-transform: uppercase;

  transition:
    color .15s ease;
}


.nav-links a:hover {

  color:
    var(--gold);
}


/* HERO */

.hero {

  text-align: center;

  padding:
    90px
    20px
    70px;

  border-bottom:
    10px solid
    var(--white);

  position: relative;
}


/* SMALL LABEL */

.label {

  color:
    var(--gold);

  font-size: 10px;

  font-weight: 900;

  letter-spacing: 4px;

  text-transform: uppercase;

  margin-bottom: 25px;
}


/* TITLE */

h1 {

  margin: 0;

  font-size:
    clamp(
      55px,
      10vw,
      115px
    );

  line-height:
    .8;

  letter-spacing:
    -6px;

  font-weight:
    900;

  text-transform:
    uppercase;
}


/* SUBTITLE */

.subtitle {

  margin-top: 30px;

  font-size: 12px;

  font-weight: 900;

  letter-spacing: 4px;

  text-transform: uppercase;

  color:
    var(--gold);
}


/* DESCRIPTION */

.description {

  max-width: 650px;

  margin:
    35px auto 0;

  font-size: 12px;

  line-height: 1.6;

  font-weight: 700;

  text-transform: uppercase;
}


/* CHAPTER AREA */

.chapter-section {

  margin-top: 80px;
}


.section-heading {

  display: flex;

  justify-content:
    space-between;

  align-items:
    flex-end;

  gap: 20px;

  margin-bottom: 35px;

  padding-bottom: 15px;

  border-bottom:
    3px solid
    var(--white);
}


.section-heading h2 {

  margin: 0;

  font-size:
    clamp(
      45px,
      8vw,
      80px
    );

  line-height: .8;

  letter-spacing: -5px;

  text-transform: uppercase;
}


.chapter-number {

  color:
    var(--gold);

  font-size: 10px;

  font-weight: 900;

  letter-spacing: 3px;

  white-space: nowrap;
}


/* CHAPTER CARD */

.chapter {

  display: block;

  background:
    var(--white);

  color:
    var(--black);

  padding: 12px;

  text-decoration: none;

  border:
    4px solid
    var(--white);

  box-shadow:
    12px 12px 0
    var(--gold);

  transition:
    transform .2s ease,
    box-shadow .2s ease;
}


.chapter:hover {

  transform:
    translateY(-10px);

  box-shadow:
    18px 18px 0
    var(--gold);
}


/* PREVIEW */

.preview {

  width: 100%;

  aspect-ratio:
    3 / 4;

  background:
    var(--black);

  overflow: hidden;

  position: relative;
}


/* GOLD BORDER */

.preview::after {

  content: "";

  position: absolute;

  inset: 0;

  border:
    4px solid
    var(--gold);

  pointer-events: none;
}


/* IMAGE */

.preview img {

  width: 100%;

  height: 100%;

  display: block;

  object-fit: cover;

  object-position:
    center top;

  transition:
    transform .4s ease;
}


.chapter:hover .preview img {

  transform:
    scale(1.04);
}


/* CHAPTER LABEL */

.chapter-label {

  position: absolute;

  top: 15px;

  left: 15px;

  z-index: 5;

  background:
    var(--gold);

  color:
    var(--black);

  padding:
    7px
    10px;

  font-size: 10px;

  font-weight: 900;

  letter-spacing: 2px;

  text-transform: uppercase;
}


/* INFO */

.chapter-info {

  padding:
    20px
    5px
    8px;
}


.chapter-title {

  font-size:
    clamp(
      28px,
      5vw,
      45px
    );

  font-weight: 900;

  letter-spacing: -3px;

  line-height: .9;

  text-transform: uppercase;
}


.chapter-description {

  margin-top: 12px;

  font-size: 11px;

  font-weight: 900;

  line-height: 1.4;

  text-transform: uppercase;
}


/* READ BUTTON */

.read {

  display: inline-block;

  margin-top: 18px;

  padding:
    11px
    16px;

  background:
    var(--black);

  color:
    var(--gold);

  font-size: 11px;

  font-weight: 900;

  letter-spacing: 2px;

  text-transform: uppercase;

  transition:
    background .15s ease,
    color .15s ease;
}


.chapter:hover .read {

  background:
    var(--gold);

  color:
    var(--black);
}


/* FOOTER */

footer {

  margin-top: 100px;

  padding-top: 20px;

  border-top:
    2px solid
    rgba(242,242,238,.25);

  text-align: center;

  font-size: 9px;

  font-weight: 900;

  letter-spacing: 3px;

  text-transform: uppercase;

  opacity: .5;
}


footer span {

  color:
    var(--gold);
}


/* MOBILE */

@media (max-width: 700px) {

  .page {

    padding:
      15px
      15px
      70px;
  }


  nav {

    align-items:
      flex-start;
  }


  .nav-links {

    gap: 12px;

    flex-wrap: wrap;

    justify-content: flex-end;
  }


  .hero {

    padding:
      70px
      10px
      55px;
  }


  h1 {

    letter-spacing:
      -4px;
  }


  .section-heading {

    display: block;
  }


  .chapter-number {

    display: block;

    margin-top: 15px;
  }


  .chapter {

    box-shadow:
      8px 8px 0
      var(--gold);
  }


  .chapter:hover {

    box-shadow:
      12px 12px 0
      var(--gold);
  }

}


</style>

</head>


<body>


<div class="page">


  <!-- NAVIGATION -->

  <nav>


    <a
      class="nav-logo"
      href="../"
    >

      SK6

    </a>


    <div class="nav-links">


      <a href="../#comics">

        Comics

      </a>


      <a href="../#latest">

        Latest News

      </a>


      <a href="../about/">

        About

      </a>


      <a href="../#support">

        Support

      </a>


      <a href="../contact/">

        Contact

      </a>


    </div>


  </nav>



  <!-- HERO -->

  <header class="hero">


    <div class="label">

      SK6 // 004

    </div>


    <h1>

      L’Héritage<br>
      de la Nuit

    </h1>


    <div class="subtitle">

      Chapter One

    </div>


    <div class="description">

      Beyond the walls, monsters rule the wild.
      Hunters stand between humanity and the
      creatures that stalk the roads, forests and villages.

    </div>


  </header>



  <!-- CHAPTER -->

  <main class="chapter-section">


    <div class="section-heading">


      <h2>

        Chapters

      </h2>


      <div class="chapter-number">

        L’HÉRITAGE DE LA NUIT

        //

        CHAPTER 01

      </div>


    </div>



    <!-- CHAPTER 01 -->

    <a
      class="chapter"
      href="chapter1/"
    >


      <div class="preview">


        <div class="chapter-label">

          CHAPTER 01

        </div>


        <!-- FIRST PAGE PREVIEW -->

        <img
          src="chapter1/H_c1_01%20Large.jpeg"
          alt="L’Héritage de la Nuit — Chapter 01"
        >


      </div>



      <div class="chapter-info">


        <div class="chapter-title">

          Chapter 01

        </div>


        <div class="chapter-description">

          Enter the darkness.
          The first chapter of
          L’Héritage de la Nuit.

        </div>


        <div class="read">

          READ CHAPTER →

        </div>


      </div>


    </a>


  </main>



  <!-- FOOTER -->

  <footer>

    SK6 © 2026

    <br><br>

    <span>
      L’HÉRITAGE DE LA NUIT
    </span>

    <br><br>

    Comics / Art / Chaos

  </footer>


</div>


</body>

</html>
